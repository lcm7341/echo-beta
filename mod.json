{
	"geode": "5.8.2",
	"gd": {
		"win": "2.2081"
	},
	"id": "decks.echo",
	"name": "Echo",
	"version": "v1.0.0",
	"developer": "decks",
	"description": "Echo is a replay tool with many features, all for free :)",
	"links": {
		"source": "https://github.com/lcm7341/Echo/"
	},
	"issues": {
		"info": "Echo for 2.2 is not open sourced yet but you can still report issues",
		"url": "https://github.com/lcm7341/Echo/issues"
	},
	"tags": [
		"gameplay",
		"utility",
		"cheat",
		"offline"
	],
	"resources": {
		"files": [
			"resources/*.ttf"
		]
	},
	"settings": {
		"toggle-record": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Toggle recording",
			"default": "F4",
			"category": "gameplay"
		},
		"toggle-play": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Toggle playback",
			"default": "F5",
			"category": "gameplay"
		},
		"toggle-advance": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Toggle frame advance",
			"default": "V",
			"category": "gameplay"
		},
		"step-frame": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Step one frame",
			"default": "C",
			"category": "gameplay"
		},
		"key-click-both": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Click both players",
			"default": "None",
			"category": "gameplay"
		},
		"key-swap": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Swap player input",
			"default": "None",
			"category": "gameplay"
		},
		"key-shakes": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Disable shake",
			"default": "None",
			"category": "gameplay"
		},
		"key-no-overwrite": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "No overwrite",
			"default": "None",
			"category": "gameplay"
		},
		"key-ignore": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Ignore actions",
			"default": "None",
			"category": "gameplay"
		},
		"key-save": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Save replay",
			"default": "None",
			"category": "gameplay"
		},
		"key-load": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Load replay",
			"default": "None",
			"category": "gameplay"
		},
		"key-reset": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Reset level",
			"default": "None",
			"category": "gameplay"
		},
		"key-speedhack": {
			"type": "keybind",
			"platforms": ["win"],
			"name": "Speedhack",
			"description": "Switch between 1x and the speed set on the slider.",
			"default": "None",
			"category": "gameplay"
		}
	}
}
