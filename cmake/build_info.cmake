string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
execute_process(COMMAND git -C "${SRC}" rev-parse --short HEAD OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE git_failed)
if (git_failed OR hash STREQUAL "")
    set(hash "nogit")
else()
    execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if (NOT dirty STREQUAL "")
        set(hash "${hash}+dirty")
    endif()
endif()
file(WRITE "${OUT}" "namespace echo {\n    char const* build_id() {\n        return \"${stamp}-${hash}\";\n    }\n}\n")
